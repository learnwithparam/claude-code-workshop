---
import { renderWorksheet, worksheetSchema } from "@workshop/shared";
import fixtures from "../../../fixtures/worksheets.json";

// Offline examples: rendered at build time, so they cost no tokens.
const examples = fixtures.map((fixture) => ({
  prompt: fixture.prompt,
  html: renderWorksheet(worksheetSchema.parse(fixture.worksheet)),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Worksheet Studio</title>
    <style>
      @font-face { font-family: Geist; src: url(/fonts/geist.woff2) format("woff2"); font-weight: 400 600; font-display: swap; }
      :root { --page: #f7f7f7; --surface: #fff; --ink: #171717; --muted: #5c5c5c; --line: #e5e5e5; --focus: #2563eb; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--page); color: var(--ink); font: 16px/1.5 Geist, system-ui, sans-serif; }
      main { display: grid; grid-template-columns: minmax(280px, 400px) 1fr; gap: 24px; max-width: 1200px; margin: 0 auto; padding: 24px 16px; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      .lede, .chip { color: var(--muted); }
      .lede { margin: 0 0 16px; }
      #log { display: grid; gap: 8px; min-height: 160px; margin-bottom: 12px; }
      .msg { padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); white-space: pre-wrap; }
      .msg.user { background: var(--ink); color: var(--surface); border-color: var(--ink); }
      form { display: flex; gap: 8px; }
      input { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; }
      button { padding: 10px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--surface); border-radius: 8px; font: inherit; cursor: pointer; }
      button.ghost { background: var(--surface); color: var(--ink); border-color: var(--line); width: 100%; text-align: left; margin-top: 8px; }
      button:disabled { opacity: .5; cursor: wait; }
      input:focus-visible, button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
      .chip { font-size: 13px; margin: 8px 0 0; min-height: 20px; }
      .preview { display: grid; gap: 8px; min-width: 0; }
      iframe { width: 100%; max-width: 816px; aspect-ratio: 816 / 1056; border: 1px solid var(--line); background: var(--surface); }
      .bar { display: flex; justify-content: space-between; align-items: center; max-width: 816px; }
      h2 { font-size: 14px; color: var(--muted); font-weight: 500; margin: 16px 0 0; }
      @media (max-width: 760px) { main { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <main>
      <section aria-label="Chat">
        <h1>Worksheet Studio</h1>
        <p class="lede">Describe the worksheet. I will ask if I need the grade.</p>
        <div id="log" role="log" aria-live="polite"></div>
        <form id="form">
          <input id="text" name="text" aria-label="Your request" placeholder="A fractions worksheet" autocomplete="off" required />
          <button id="send" type="submit">Send</button>
        </form>
        <p class="chip" id="chip" aria-live="polite"></p>
        <h2>Examples, no tokens used</h2>
        {examples.map((example, index) => (
          <button type="button" class="ghost" data-example={index}>{example.prompt}</button>
        ))}
      </section>
      <section class="preview" aria-label="Worksheet preview">
        <div class="bar"><span class="chip">Preview</span><button type="button" id="print" class="ghost" style="width:auto;margin:0">Print / Save PDF</button></div>
        <iframe id="frame" title="Worksheet preview" srcdoc={examples[0]?.html}></iframe>
      </section>
    </main>
    <script>
      import { chat, type ChatMessage } from "../lib/api.ts";

      const log = document.getElementById("log") as HTMLElement;
      const form = document.getElementById("form") as HTMLFormElement;
      const text = document.getElementById("text") as HTMLInputElement;
      const send = document.getElementById("send") as HTMLButtonElement;
      const chip = document.getElementById("chip") as HTMLElement;
      const frame = document.getElementById("frame") as HTMLIFrameElement;
      const history: ChatMessage[] = [];

      const add = (role: "user" | "assistant", content: string) => {
        const div = document.createElement("div");
        div.className = `msg ${role}`;
        div.textContent = content;
        log.append(div);
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const content = text.value.trim();
        if (!content) return;
        text.value = "";
        send.disabled = true;
        history.push({ role: "user", content });
        add("user", content);
        for await (const ev of chat(history)) {
          if (ev.event === "question") {
            history.push({ role: "assistant", content: ev.data.text });
            add("assistant", ev.data.text);
          } else if (ev.event === "worksheet") {
            frame.srcdoc = ev.data.html;
            history.push({ role: "assistant", content: "Here is your worksheet." });
            add("assistant", "Here is your worksheet.");
          } else if (ev.event === "usage") {
            const u = ev.data;
            chip.textContent = `${u.input} in, ${u.cacheRead} cached, ${u.output} out, $${u.costUsd.toFixed(4)}`;
          } else {
            add("assistant", ev.data.message);
          }
        }
        send.disabled = false;
        text.focus();
      });

      for (const btn of document.querySelectorAll<HTMLButtonElement>("button[data-example]")) {
        btn.addEventListener("click", () => {
          const html = (window as unknown as { __examples: string[] }).__examples[Number(btn.dataset.example)];
          if (html) frame.srcdoc = html;
        });
      }
      document.getElementById("print")?.addEventListener("click", () => frame.contentWindow?.print());
    </script>
    <script define:vars={{ examples: examples.map((e) => e.html) }}>
      window.__examples = examples;
    </script>
  </body>
</html>
