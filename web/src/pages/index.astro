---
import { renderWorksheet, worksheetSchema } from "@workshop/shared";
import fixtures from "../../../fixtures/worksheets.json";
import { EXAMPLE_PROMPTS } from "../lib/example-prompts.ts";

// The first fixture is the opening page, rendered at build time so it costs no tokens.
const firstPage = fixtures[0] ? renderWorksheet(worksheetSchema.parse(fixtures[0].worksheet)) : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Worksheet Studio</title>
    <style>
      @font-face { font-family: Geist; src: url(/fonts/geist.woff2) format("woff2"); font-weight: 400 600; font-display: swap; }
      :root { --page: #f7f7f7; --surface: #fff; --ink: #171717; --muted: #5c5c5c; --line: #e5e5e5; --focus: #2563eb; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--page); color: var(--ink); font: 16px/1.5 Geist, system-ui, sans-serif; }
      main { display: grid; grid-template-columns: minmax(280px, 400px) 1fr; gap: 24px; max-width: 1200px; margin: 0 auto; padding: 24px 16px; }
      h1 { font-size: 20px; margin: 0 0 4px; }
      .lede, .chip { color: var(--muted); }
      .lede { margin: 0 0 16px; }
      #log { display: grid; gap: 8px; min-height: 160px; margin-bottom: 12px; }
      .msg { padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); white-space: pre-wrap; }
      .msg.user { background: var(--ink); color: var(--surface); border-color: var(--ink); }
      form { display: flex; gap: 8px; }
      input { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; }
      button { padding: 10px 14px; border: 1px solid var(--ink); background: var(--ink); color: var(--surface); border-radius: 8px; font: inherit; cursor: pointer; }
      button.ghost { background: var(--surface); color: var(--ink); border-color: var(--line); width: 100%; text-align: left; margin-top: 8px; }
      button:disabled { opacity: .5; cursor: wait; }
      #examples { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
      #examples button.ghost { width: auto; margin: 0; min-height: 44px; }
      #examples button[aria-pressed="true"] { border-color: var(--ink); border-width: 2px; font-weight: 600; }
      #strip { max-width: 816px; min-height: 143px; }
      #strip ul { display: flex; gap: 12px; margin: 0; padding: 4px; list-style: none; overflow-x: auto; }
      #strip li { flex: none; }
      .thumb { position: relative; width: 98px; height: 127px; border: 1px solid var(--line); background: var(--surface); overflow: hidden; }
      .thumb.skeleton { background: var(--line); }
      .thumb iframe { position: absolute; top: 0; left: 0; width: 816px; max-width: none; height: 1056px; aspect-ratio: auto; border: 0; transform: scale(.12); transform-origin: 0 0; pointer-events: none; }
      .thumb button { position: absolute; inset: 0; width: 100%; padding: 0; background: transparent; border: 0; border-radius: 0; }
      .thumb.current { outline: 3px solid var(--ink); outline-offset: 2px; }
      .thumb .tag { position: absolute; right: 0; bottom: 0; padding: 0 6px; background: var(--ink); color: var(--surface); font-size: 12px; }
      input:focus-visible, button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
      .chip { font-size: 13px; margin: 8px 0 0; min-height: 20px; }
      .preview { display: grid; gap: 8px; min-width: 0; }
      iframe { width: 100%; max-width: 816px; aspect-ratio: 816 / 1056; border: 1px solid var(--line); background: var(--surface); }
      .bar { display: flex; justify-content: space-between; align-items: center; max-width: 816px; }
      h2 { font-size: 14px; color: var(--muted); font-weight: 500; margin: 16px 0 0; }
      @media (max-width: 760px) { main { grid-template-columns: 1fr; } #examples { flex-direction: column; } #examples button.ghost { width: 100%; } }
      @media print { #strip, #examples { display: none; } }
    </style>
  </head>
  <body>
    <main>
      <section aria-label="Chat">
        <h1>Worksheet Studio</h1>
        <p class="lede">Describe the worksheet. I will ask if I need the grade.</p>
        <div id="log" role="log" aria-live="polite"></div>
        <form id="form">
          <input id="text" name="text" aria-label="Your request" placeholder="A fractions worksheet" autocomplete="off" required />
          <button id="send" type="submit">Send</button>
        </form>
        <p class="chip" id="chip" aria-live="polite"></p>
        <h2 id="examples-label">Examples, fill the box only</h2>
        <ul id="examples" aria-labelledby="examples-label">
          {EXAMPLE_PROMPTS.map((prompt) => (
            <li><button type="button" class="ghost" data-example={prompt} aria-pressed="false">{prompt}</button></li>
          ))}
        </ul>
      </section>
      <section class="preview" aria-label="Worksheet preview">
        <div class="bar"><span class="chip">Preview</span><button type="button" id="print" class="ghost" style="width:auto;margin:0">Print / Save PDF</button></div>
        <iframe id="frame" title="Worksheet preview" srcdoc={firstPage}></iframe>
        <nav id="strip" aria-label="Worksheet pages"><ul id="pages"></ul></nav>
      </section>
    </main>
    <script>
      import { chat, type ChatMessage } from "../lib/api.ts";
      import { remember } from "../lib/history.ts";
      import { stripSlots } from "../lib/page-strip.ts";

      const log = document.getElementById("log") as HTMLElement;
      const form = document.getElementById("form") as HTMLFormElement;
      const text = document.getElementById("text") as HTMLInputElement;
      const send = document.getElementById("send") as HTMLButtonElement;
      const chip = document.getElementById("chip") as HTMLElement;
      const frame = document.getElementById("frame") as HTMLIFrameElement;
      const strip = document.getElementById("strip") as HTMLElement;
      const pageList = document.getElementById("pages") as HTMLElement;
      const exampleButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-example]")];
      const history: ChatMessage[] = [];
      const pages: string[] = [frame.srcdoc];
      let active = 0;
      let loading = false;

      const add = (role: "user" | "assistant", content: string) => {
        const div = document.createElement("div");
        div.className = `msg ${role}`;
        div.textContent = content;
        log.append(div);
      };

      const show = (index: number) => {
        active = index;
        frame.srcdoc = pages[index] ?? "";
        drawStrip();
        pageList.querySelectorAll("button")[index]?.focus();
      };

      // Redrawn in place; the button at the active index keeps focus so keyboard users do not lose their spot.
      function drawStrip() {
        const slots = stripSlots(pages.length, active, loading);
        strip.hidden = slots.length === 0;
        const focused = pageList.contains(document.activeElement) ? [...pageList.querySelectorAll("button")].indexOf(document.activeElement as HTMLButtonElement) : -1;
        pageList.replaceChildren(
          ...slots.map((slot, i) => {
            const li = document.createElement("li");
            const thumb = document.createElement("div");
            thumb.className = `thumb${slot.skeleton ? " skeleton" : ""}${slot.current ? " current" : ""}`;
            if (slot.skeleton) {
              thumb.setAttribute("role", "img");
              thumb.setAttribute("aria-label", slot.label);
            } else {
              const mini = document.createElement("iframe");
              mini.srcdoc = pages[i] ?? "";
              mini.tabIndex = -1;
              mini.setAttribute("aria-hidden", "true");
              mini.setAttribute("inert", "");
              mini.title = "";
              const btn = document.createElement("button");
              btn.type = "button";
              btn.setAttribute("aria-label", slot.label);
              if (slot.current) btn.setAttribute("aria-current", "page");
              btn.addEventListener("click", () => show(i));
              thumb.append(mini, btn);
              if (slot.current) {
                const tag = document.createElement("span");
                tag.className = "tag";
                tag.setAttribute("aria-hidden", "true");
                tag.textContent = "Viewing";
                thumb.append(tag);
              }
            }
            li.append(thumb);
            return li;
          }),
        );
        if (focused >= 0) pageList.querySelectorAll("button")[Math.min(focused, pages.length - 1)]?.focus();
      }

      const lock = (busy: boolean) => {
        send.disabled = busy;
        for (const btn of exampleButtons) btn.disabled = busy;
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const content = text.value.trim();
        if (!content) return;
        text.value = "";
        for (const btn of exampleButtons) btn.setAttribute("aria-pressed", "false");
        lock(true);
        loading = true;
        drawStrip();
        history.push({ role: "user", content });
        add("user", content);
        for await (const ev of chat(history)) {
          if (ev.event === "worksheet") {
            pages.splice(0, pages.length, ev.data.html);
            active = 0;
            frame.srcdoc = ev.data.html;
          }
          const shown = remember(history, ev);
          if (shown) add("assistant", shown);
          if (ev.event === "usage") {
            const u = ev.data;
            chip.textContent = `${u.input} in, ${u.cacheRead} cached, ${u.output} out, $${u.costUsd.toFixed(4)}`;
          }
        }
        loading = false;
        drawStrip();
        lock(false);
        text.focus();
      });

      // An example only fills the box. Sending spends tokens, so the visitor presses Send.
      for (const btn of exampleButtons) {
        btn.addEventListener("click", () => {
          text.value = btn.dataset.example ?? "";
          for (const other of exampleButtons) other.setAttribute("aria-pressed", String(other === btn));
          text.focus();
        });
      }
      document.getElementById("print")?.addEventListener("click", () => frame.contentWindow?.print());
      drawStrip();
    </script>
  </body>
</html>
