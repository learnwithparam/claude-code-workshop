{
  "name": "claude-code-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "api"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && (test ! -d factory || tsc --noEmit -p factory) && (test ! -d lab || tsc --noEmit -p lab)",
    "test": "vitest run",
    "lint": "biome ci .",
    "e2e": "test ! -f playwright.config.ts || playwright test",
    "prove": "tsx scripts/prove/run.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "hyperframes": "^0.8.212",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  }
}
