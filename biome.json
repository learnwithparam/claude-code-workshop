{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!fixtures",
      "!supplied",
      "!test-results",
      "!playwright-report",
      "!.workshop-home",
      "!web/.astro",
      "!**/*.astro",
      "!.claude/workflows"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noDefaultExport": "error" }
    }
  },
  "overrides": [
    {
      "includes": [
        "web/src/pages/**",
        "**/astro.config.*",
        "vitest.config.ts",
        "playwright.config.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
